{
  "expo": {
    "name": "HypKnotic",
    "slug": "hypknotic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6E6FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hypknotic.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E6E6FA"
      },
      "package": "com.hypknotic.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "hypknotic"
      }
    }
  }
}
